_excerpt_shown = True
_excerpt_lines = 0


def rotate_log():
    """Keep the log bounded: one rotation, so it never exceeds 2x the limit."""
    if _log_max_bytes <= 0:
        return
    try:
        if os.path.getsize(LOG_FILE) > _log_max_bytes:
            os.replace(LOG_FILE, LOG_FILE + ".1")
    except OSError:
        pass


def log(msg, echo=True):
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    rotate_log()
    with open(LOG_FILE, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    if echo:
        print(line, flush=True)


def load_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
            fh.write(DEFAULT_CONFIG)
        log("created default config at %s (DRY_RUN=1)" % CONFIG_FILE)
    cfg = dict(DEFAULTS)
    with open(CONFIG_FILE, encoding="utf-8") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            key = key.strip()
            val = val.strip()
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            cfg[key] = val

    # An upgrade can add keys; append the missing ones (with their comments) so
    # the file stays a complete, editable record of what is tunable.
    with open(CONFIG_FILE, encoding="utf-8") as fh:
        body = fh.read()
    missing = ["\n%s%s=%s\n" % ("".join("# %s\n" % c for c in comment.split("\n")),
                                key, val)
               for key, val, comment in CONFIG_KEYS
               if not re.search(r"^\s*%s\s*=" % re.escape(key), body, re.M)]
    if missing:
        with open(CONFIG_FILE, "a", encoding="utf-8") as fh:
            fh.write("".join(missing))

    global _log_max_bytes, _excerpt_shown, _excerpt_lines
    try:
        _log_max_bytes = int(float(cfg["LOG_MAX_KB"]) * 1024)
    except (ValueError, KeyError):
        pass
    # A global rather than a parameter because write_stub_file is reached from
    # five call sites that have no config in hand — same reason as the log cap.
    _excerpt_shown, _excerpt_lines = _parse_excerpt_lines(cfg.get("EXCERPT_LINES"))
    return cfg


def _parse_excerpt_lines(raw):
    """(show the excerpt?, per-turn line cap with 0 = uncapped)."""
    word = str(raw if raw is not None else "all").strip().strip('"\'').lower()
    if word in ("all", "full", "-1"):
        return True, 0
    try:
        count = int(float(word))
    except ValueError:
        return True, 0  # an unreadable setting must not silently hide anything
    return (count > 0), max(0, count)


_herdr_bin = None


def herdr_bin():
    """Absolute path to the herdr CLI.

    A `type = "shell"` keybinding is spawned by the Herdr server with a bare
    PATH that need not include ~/.local/bin, so relying on PATH makes the tool
    die with FileNotFoundError where nobody can see it.
    """
    global _herdr_bin
    if _herdr_bin:
        return _herdr_bin
    injected = os.environ.get("HERDR_BIN_PATH")
    if injected and os.access(injected, os.X_OK):
        _herdr_bin = injected
        return _herdr_bin
    found = shutil.which("herdr")
    if not found:
        for cand in ("~/.local/bin/herdr", "/usr/local/bin/herdr",
                     "/usr/bin/herdr", "/opt/herdr/bin/herdr"):
            cand = os.path.expanduser(cand)
            if os.access(cand, os.X_OK):
                found = cand
                break
    _herdr_bin = found or "herdr"
    return _herdr_bin


def herdr(*args):
    """Run a herdr CLI command, return the parsed `result` object."""
    try:
        out = subprocess.run(
            [herdr_bin(), *args], capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise RuntimeError("cannot run herdr (%s): %s" % (herdr_bin(), exc))
    if out.returncode != 0:
        raise RuntimeError("herdr %s failed: %s" % (" ".join(args), out.stderr.strip()))
    try:
        return json.loads(out.stdout)["result"]
    except (ValueError, KeyError):
        # Some commands (e.g. `pane run`) print nothing / non-JSON on success.
        return {}


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = "%s.tmp.%d" % (STATE_FILE, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, indent=2)
        os.replace(tmp, STATE_FILE)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


@contextlib.contextmanager
def file_lock(path, blocking=True):
    """Hold an advisory process lock. Yield False when a nonblocking lock is busy."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fh = open(path, "a+")
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    try:
        try:
            fcntl.flock(fh.fileno(), flags)
        except BlockingIOError:
            fh.close()
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    finally:
        if not fh.closed:
            fh.close()


def watcher_lock_active():
    """True when another process holds the watcher singleton lock."""
    with file_lock(WATCH_LOCK_FILE, blocking=False) as acquired:
        return not acquired


def run_locked(func, *args, **kwargs):
    """Serialize every state-changing one-shot operation."""
    with file_lock(OPERATION_LOCK_FILE):
        return func(*args, **kwargs)


TS_RE = re.compile(rb'"timestamp"\s*:\s*"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)')
TS_EPOCH_RE = re.compile(rb'"timestamp"\s*:\s*(\d{9,12})\b')  # grok: epoch ints
TAIL_BYTES = 2 * 1024 * 1024


def _stamp_epochs(chunk, allow_epoch=False):
    """All parseable entry timestamps in a transcript chunk, as epoch seconds."""
    out = []
    for iso in TS_RE.findall(chunk):
        try:
            out.append(calendar.timegm(
                time.strptime(iso.decode("ascii", "ignore"),
                              "%Y-%m-%dT%H:%M:%S")))
        except ValueError:
            pass
    if allow_epoch:
        for num in TS_EPOCH_RE.findall(chunk):
            val = int(num)
            if 1_000_000_000 <= val <= 4_102_444_800:  # sane range: 2001..2100
                out.append(val)
    return out


def last_entry_epoch(path, allow_epoch=False):
    """Epoch of the newest timestamped entry in a transcript, or None.

    The file's mtime is NOT a usable idle signal: Claude Code keeps rewriting
    bookkeeping lines (e.g. `last-prompt`, which carries no timestamp) long
    after the conversation goes quiet, so a 3-day-old session can show an mtime
    of seconds ago. Only entries that carry their own timestamp mark real
    activity, so read those.
    """
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > TAIL_BYTES:
                fh.seek(size - TAIL_BYTES)
            stamps = _stamp_epochs(fh.read(), allow_epoch)
            if not stamps and size > TAIL_BYTES:  # rare: no stamps in the tail
                fh.seek(0)
                stamps = _stamp_epochs(fh.read(), allow_epoch)
    except OSError:
        return None
    return max(stamps) if stamps else None


def transcript_age_minutes(uuid, agent="claude"):
    """Minutes since this session's last real activity, or None if no transcript.

    Activity is the newest stamped entry across the main transcript AND the
    agent's activity_globs (e.g. claude sub-agent transcripts): an orchestrator
    whose background workers are still writing is active, not idle.
    """
    spec = AGENTS.get(agent)
    if spec is None:
        return None
    patterns = (spec["transcript_glob"],) + tuple(spec.get("activity_globs", ()))
    paths = [p for pat in patterns for p in glob.glob(pat.format(sid=uuid))]
    if not glob.glob(spec["transcript_glob"].format(sid=uuid)):
        return None  # resumability needs the MAIN transcript, whatever else exists
    newest = None
    for path in paths:
        stamp = last_entry_epoch(path, spec.get("epoch_ts", False))
        if stamp is None:  # unreadable/unstamped — fall back to the file clock
            try:
                stamp = os.stat(path).st_mtime
            except OSError:
                continue
        if newest is None or stamp > newest:
            newest = stamp
    if newest is None:
        return None
    return max(0.0, (time.time() - newest) / 60.0)


# ------------------------------------------------- last exchange (stub excerpt)
#
# A killed agent's conversation is gone: Claude Code, Codex and Grok all draw on
# the alternate screen buffer, so the moment the process exits the terminal
# restores the normal buffer and every visible turn goes with it. Nothing the
# watcher does can preserve that scrollback. The only text that survives is text
# the stub itself prints, so the stub reprints the tail of the conversation from
# the transcript that is already on disk.

EXCERPT_TAIL_BYTES = 1024 * 1024
EXCERPT_WIDE_TAIL_BYTES = 12 * 1024 * 1024

# Pseudo-user entries: hooks, slash-command wrappers, background task results
# and skill injections all arrive as role "user". None of them is something the
# human typed, so none belongs in an excerpt labelled "you".
MACHINE_TURN_PREFIXES = (
    "<task-notification", "<command-name", "<command-message", "<command-args",
    "<local-command-stdout", "<local-command-stderr", "<system-reminder",
    "<user-prompt-submit-hook", "<bash-input", "<bash-stdout", "<bash-stderr",
    "<environment_context", "<user_instructions", "# AGENTS.md instructions",
    "Caveat:", "This session is being continued from a previous conversation",
)
REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
# Codex appends its memory-citation markup to the message text itself, and it
# is longer than some replies. Matched generically because the tag names have
# already changed once.
CITATION_RE = re.compile(r"<(oai-[a-z-]+|citation_entries|rollout_ids)\b.*?"
                         r"(</\1>|$)", re.S)
# `[label](path)` reads as punctuation soup at a glance; the label is the part
# that carries meaning, and the stub is not a place anything gets clicked.
MD_LINK_RE = re.compile(r"\[([^\]\n]{1,120})\]\((?:[^)\n]{0,300})\)")
# A bare slash command (/compact, /clear) is an instruction to the harness, not
# a turn in the conversation, and the last one is often the only thing standing
# between the reader and the exchange they actually want to recognise.
BARE_COMMAND_RE = re.compile(r"^/[A-Za-z0-9:._-]+$")


def _tail_objects(path, limit=None):
    """Parsed JSON lines from the end of a transcript, oldest first.

    A partial first line is expected whenever the file is bigger than the
    window, and simply fails to parse — no need to hunt for a line boundary.
    """
    limit = EXCERPT_TAIL_BYTES if limit is None else limit
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > limit:
                fh.seek(size - limit)
            raw = fh.read()
    except OSError:
        return []
    objects = []
    for line in raw.splitlines():
        try:
            obj = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        if isinstance(obj, dict):
            objects.append(obj)
    return objects


def _clean_turn_text(text):
    """One flowed paragraph, or '' if the text is machine chatter.

    Wrapping happens in the stub at print time (the pane can be resized after
    hibernation), so everything here collapses to a single logical line.
    """
    text = REMINDER_RE.sub("", text or "").strip()
    if not text or text.startswith(MACHINE_TURN_PREFIXES):
        return ""
    if BARE_COMMAND_RE.match(text):
        return ""
    text = CITATION_RE.sub("", text)
    text = MD_LINK_RE.sub(r"\1", text)
    text = re.sub(r"^#{1,6}\s+", "", text, flags=re.M)  # headings read as noise
    text = re.sub(r"^\s*\|[\s|:-]*\|\s*$", "", text, flags=re.M)  # table rules
    text = text.replace("**", "").replace("|", " ")
    return reflow(text)


FENCE_RE = re.compile(r"^\s*```")
LIST_ITEM_RE = re.compile(r"^\s*(?:[-*+]\s|\d{1,3}[.)]\s)")


def reflow(text):
    """Flow prose into one line per paragraph, but keep lists and code intact.

    Collapsing every newline turned a fenced block of shell commands into a
    single run-on line with the commands abutting each other — unreadable, and
    worse, nothing you could copy. Prose has no such shape to lose, so it is
    still flowed: the stub wraps to the pane width at print time and a source
    line break in the middle of a sentence means nothing here.
    """
    lines, buffer, in_code = [], [], False

    def flush():
        if buffer:
            lines.append(" ".join(" ".join(buffer).split()))
            del buffer[:]

    for raw in text.splitlines():
        if FENCE_RE.match(raw):
            flush()
            in_code = not in_code
            continue
        if in_code:
            flush()
            lines.append(raw.rstrip().replace("`", ""))
            continue
        if not raw.strip():
            flush()
            continue
        if LIST_ITEM_RE.match(raw):
            flush()  # a marker always starts a new line; its wrapped
        buffer.append(raw)  # continuation joins it, having no marker of its own
    flush()
    return "\n".join(line for line in lines if line.strip()).replace("`", "")


def _claude_turns(objects):
    """Every real turn in a Claude Code transcript, oldest first."""
    turns = []
    for obj in objects:
        kind = obj.get("type")
        if kind not in ("user", "assistant") or obj.get("isSidechain"):
            continue
        if kind == "user" and (obj.get("isMeta")
                               or obj.get("toolUseResult") is not None):
            continue
        content = (obj.get("message") or {}).get("content")
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            text = " ".join(block.get("text", "") for block in content
                            if isinstance(block, dict)
                            and block.get("type") == "text")
        else:
            continue
        text = _clean_turn_text(text)
        if text:
            turns.append(("user" if kind == "user" else "agent", text))
    return turns


def _codex_turns(objects):
    """Every real turn in a Codex rollout file, oldest first."""
    turns = []
    for obj in objects:
        payload = obj.get("payload")
        if not isinstance(payload, dict) or payload.get("type") != "message":
            continue
        role = payload.get("role")
        blocks = payload.get("content")
        if role not in ("user", "assistant") or not isinstance(blocks, list):
            continue
        text = _clean_turn_text(" ".join(
            block.get("text", "") for block in blocks
            if isinstance(block, dict)))
        if text:
            turns.append(("user" if role == "user" else "agent", text))
    return turns


def tail_exchange(turns):
    """The last answered exchange, plus a trailing prompt still unanswered.

    Showing only the newest prompt and its reply reads as nothing at all when
    the newest prompt has no reply yet — a pane parked mid-turn, or one where
    the last thing typed was `test`, says `you test` and stops. The answered
    exchange behind it is the part that identifies the pane, and the unanswered
    prompt on the end is what the agent was about to do, so both are shown.
    """
    trailing = []
    if turns and turns[-1][0] == "user":
        trailing = [turns[-1]]
        turns = turns[:-1]
    for index in range(len(turns) - 1, -1, -1):
        if turns[index][0] != "agent":
            continue
        prompt = next((turn for turn in reversed(turns[:index])
                       if turn[0] == "user"), None)
        return ([prompt] if prompt else []) + [turns[index]] + trailing
    return trailing


# Registered after definition: AGENTS is declared at the top of the file as the
# single place agent differences live, but these readers need the helpers above.
# Grok has no reader yet (no rollout on hand to verify its schema against); a
# missing reader simply means no excerpt, which is the pre-excerpt banner.
AGENTS["claude"]["turn_reader"] = _claude_turns
AGENTS["codex"]["turn_reader"] = _codex_turns


def last_exchange(uuid, agent="claude"):
    """[(role, text)] for the tail of a session's conversation, possibly empty.

    Roles are "user" and "agent". Only the MAIN transcript is read: sub-agent
    transcripts (activity_globs) are deliberately excluded, because what the
    supervisor wants to recognise is their own conversation, not a worker's.
    """
    spec = AGENTS.get(agent) or {}
    reader = spec.get("turn_reader")
    if reader is None:
        return []
    paths = glob.glob(spec["transcript_glob"].format(sid=uuid))
    if not paths:
        return []
    try:
        newest = max(paths, key=os.path.getmtime)
    except OSError:
        return []
    try:
        turns = tail_exchange(reader(_tail_objects(newest)))
        if not {"user", "agent"} <= {role for role, _ in turns}:
            # A long tool-heavy stretch buries the conversation: a 27MB Codex
            # rollout here had exactly one real turn in its last megabyte. The
            # trigger is a missing REPLY rather than a missing prompt, because
            # a lone unanswered prompt is precisely the useless case. Widening
            # once is far cheaper than reading every transcript at this size.
            try:
                oversized = os.path.getsize(newest) > EXCERPT_TAIL_BYTES
            except OSError:
                oversized = False
            if oversized:
                wider = tail_exchange(
                    reader(_tail_objects(newest, EXCERPT_WIDE_TAIL_BYTES)))
                if wider:
                    turns = wider
    except Exception:  # a transcript schema change must never block a stub
        return []
    # Returned whole. Shortening a turn is the display's business, and by
    # default the display does not shorten it either: a half-quoted answer is
    # exactly the thing that sends you back into the pane to read the rest.
    return turns



def ps_snapshot():
    """{pid: (ppid, rss_kb, args)} for all processes."""
    out = subprocess.run(
        ["ps", "-eo", "pid=,ppid=,rss=,args="], capture_output=True, text=True
    ).stdout
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        try:
            procs[int(parts[0])] = (int(parts[1]), int(parts[2]), parts[3])
        except ValueError:
            continue
    return procs


def proc_uptime_minutes(pid):
    """Minutes since a process started, or None if it cannot be read."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            fields = fh.read().rpartition(b")")[2].split()
        starttime_ticks = int(fields[19])  # field 22, 1-based, after comm
        with open("/proc/uptime") as fh:
            uptime = float(fh.read().split()[0])
    except (OSError, IndexError, ValueError):
        return None
    ticks = os.sysconf("SC_CLK_TCK") or 100
    return max(0.0, (uptime - starttime_ticks / ticks) / 60.0)


def descendants(root, procs):
    kids = {}
    for pid, (ppid, _, _) in procs.items():
        kids.setdefault(ppid, []).append(pid)
    result, stack = [], [root]
    while stack:
        pid = stack.pop()
        for child in kids.get(pid, []):
            result.append(child)
            stack.append(child)
    return result


def tree_rss_mb(root, procs):
    pids = [root] + descendants(root, procs)
    return sum(procs[p][1] for p in pids if p in procs) // 1024


def own_ancestors():
    """PIDs of this process and all its ancestors (never kill these)."""
    procs = ps_snapshot()
    out, pid = set(), os.getpid()
    while pid and pid in procs:
        out.add(pid)
        pid = procs[pid][0]
    return out


def fmt_idle(minutes):
    if minutes is None:
        return "?"
    minutes = int(minutes)
    if minutes < 60:
        return "%dm" % minutes
    hours, mins = divmod(minutes, 60)
    if hours < 48:
        return "%dh%02dm" % (hours, mins)
    return "%dd%02dh" % divmod(hours, 24)


# ------------------------------------------------------------- herdr state

def collect_panes():
    """All panes across all workspaces + tab label map."""
    panes, tab_labels = [], {}
    for ws in herdr("workspace", "list")["workspaces"]:
        ws_id = ws["workspace_id"]
        for tab in herdr("tab", "list", "--workspace", ws_id)["tabs"]:
            tab_labels[tab["tab_id"]] = tab.get("label", "")
        panes.extend(herdr("pane", "list", "--workspace", ws_id)["panes"])
    agent_names = {
        agent["pane_id"]: agent.get("name")
        for agent in herdr("agent", "list").get("agents", [])
        if agent.get("pane_id") and agent.get("name")
    }
    for pane in panes:
        if pane["pane_id"] in agent_names:
            pane["name"] = agent_names[pane["pane_id"]]
    return panes, tab_labels


def workspace_records(workspace_id, panes, state):
    """Tracked pane records belonging to a workspace.

    Prefer the live pane's explicit workspace id. New records also persist the
    id so a temporarily missing or renumbered pane remains attributable without
    deriving anything from Herdr's opaque public ids.
    """
    live_workspace = {
        pane["pane_id"]: pane.get("workspace_id") for pane in panes
    }
    return [
        (pane_id, rec) for pane_id, rec in state.items()
        if live_workspace.get(pane_id, rec.get("workspace_id")) == workspace_id
    ]


# How long after an agent starts its own arguments are trusted as the source of
# a session id. Herdr normally reports the id within seconds; this only has to
# cover that gap, and keeping it short bounds the one case where the arguments
# lie — a session cleared or forked after being resumed, whose process still
# names the id it was started with.
ARGV_SESSION_WINDOW_MINUTES = 10


def session_uuid(pane, info=None):
    sess = pane.get("agent_session")
    if isinstance(sess, dict) and sess.get("value"):
        return sess["value"]
    if pane.get("agent") == "grok":
        found = grok_session_id(pane)
        if found:
            return found
    return resumed_session_in_args(pane, info)


def resumed_session_in_args(pane, info=None):
    """Recover a just-resumed session's id from the agent's own arguments.

    Herdr repopulates agent_session on its own schedule, so for a short while
    after a resume it reports nothing at all — and a pane resumed by mistake
    cannot be parked again, which is exactly the moment you want to park it.
    The process is not ambiguous about it: it was started as
    `claude --resume <uuid>`, and that is what this reads.

    Two different ids visible in one pane means something is happening that
    this tool has no record of, so it declines rather than guessing which one
    a kill would be safe for.
    """
    spec = AGENTS.get(pane.get("agent"))
    if spec is None:
        return None
    info = pane_process_info(pane["pane_id"]) if info is None else info
    ids = set()
    for proc in (info or {}).get("foreground_processes") or []:
        line = proc.get("cmdline") or ""
        if any(token in line for token in spec["helper_tokens"]):
            continue
        found = re.search(spec["session_in_args"], line)
        if not found:
            continue
        up = proc_uptime_minutes(proc.get("pid") or 0)
        if up is None or up > ARGV_SESSION_WINDOW_MINUTES:
            continue
        ids.add(found.group(1))
    if len(ids) != 1:
        return None
    uuid = ids.pop()
    log("%s: read session %s from the agent's own arguments — Herdr has not "
        "reported it yet" % (pane["pane_id"], uuid), echo=False)
    return uuid


def grok_session_id(pane):
    """Recover a grok pane's session id from grok's own registry.

    Herdr has no grok integration, so agent_session is never populated. Grok
    itself records {session_id, pid, cwd} per live session; match the pane's
    grok process pid against it (pid alone could be recycled, so cwd must
    agree too). A crashed session can leave a stale entry behind — matching
    against the pane's CURRENT foreground pids filters those out.
    """
    info = pane_process_info(pane["pane_id"])
    if not info:
        return None
    pids = {p.get("pid") for p in info.get("foreground_processes") or []
            if p.get("pid") and _matches_agent(p, "grok")}
    if not pids:
        return None
    try:
        with open(os.path.expanduser("~/.grok/active_sessions.json"),
                  encoding="utf-8") as fh:
            entries = json.load(fh)
    except (OSError, ValueError):
        return None
    for entry in entries if isinstance(entries, list) else []:
        if entry.get("pid") not in pids or entry.get("cwd") != pane.get("cwd"):
            continue
        # pid+cwd can BOTH repeat if the OS recycled the pid for a new grok in
        # the same directory. A legit entry is written at process launch, so
        # its opened_at must sit near the live process's start time.
        opened, up = entry.get("opened_at"), proc_uptime_minutes(entry["pid"])
        if opened and up is not None:
            try:
                opened_epoch = calendar.timegm(
                    time.strptime(opened, "%Y-%m-%dT%H:%M:%SZ"))
                if abs((time.time() - up * 60) - opened_epoch) > 600:
                    continue  # stale entry from a dead session; pid recycled
            except ValueError:
                pass  # unparseable opened_at — don't reject on formatting
        return entry.get("session_id")
    return None


_INTERPRETERS = ("node", "bun", "deno", "python", "python3")


def _matches_agent(p, bin_name):
    if p.get("name") == bin_name:
        return True
    argv = p.get("argv") or []
    if not argv:
        return False
    if os.path.basename(argv[0]) in (bin_name, bin_name + ".js"):
        return True
    # An interpreter wrapper (`node .../bin/codex ...`) puts the agent's name
    # second — but ONLY behind a known interpreter, or `vim codex` matches too.
    return (len(argv) > 1
            and os.path.basename(argv[0]) in _INTERPRETERS
            and os.path.basename(argv[1]) in (bin_name, bin_name + ".js"))


def find_agent_proc(pane_id, uuid, agent):
    """The root process of a pane's agent, from herdr's process info.

    Returns (pid, proc-dict) or (None, reason).
    """
    spec = AGENTS.get(agent)
    if spec is None:
        return None, "unsupported agent %s" % agent
    info = pane_process_info(pane_id)
    if not info:
        return None, "no process info for pane"
    procs = info.get("foreground_processes") or []
    found = [p for p in procs if _matches_agent(p, spec["bin"])]
    # Ignore helper processes that are not an interactive session.
    found = [
        p for p in found
        if not any(tok in p.get("cmdline", "")
                   for tok in spec["helper_tokens"])
    ]
    if not found:
        return None, "no %s process in pane foreground" % agent
    if uuid:
        matched = [p for p in found if uuid in p.get("cmdline", "")]
        if matched:
            found = matched
        else:
            # A freshly started agent carries no session id in args; accept it
            # only if it names no OTHER session id.
            for p in found:
                other = re.search(spec["session_in_args"], p.get("cmdline", ""))
                if other and other.group(1) != uuid:
                    return None, "pane %s runs a different session (%s)" % (
                        agent, other.group(1))
    if len(found) > 1:
        # A wrapper and its child both match (node shim + vendored codex
        # binary). Collapse to the wrapper ONLY for that exact shape: two
        # processes, direct parent/child, same arguments after the agent name.
        # Anything else (e.g. a nested second session) is refused — collapsing
        # there would kill a session the tool has no record for.
        def _tail(p):
            argv = p.get("argv") or []
            for i, tok in enumerate(argv):
                if os.path.basename(tok) in (spec["bin"], spec["bin"] + ".js"):
                    return argv[i + 1:]
            return None

        collapsed = None
        if len(found) == 2 and all(p.get("pid") for p in found):
            procs_all = ps_snapshot()
            a, b = found
            for parent, child in ((a, b), (b, a)):
                direct = procs_all.get(child["pid"], (None,))[0] == parent["pid"]
                if direct and _tail(parent) == _tail(child) is not None:
                    collapsed = parent
                    break
        if collapsed is None:
            return None, "multiple %s processes in pane; refusing to guess" % agent
        found = [collapsed]
    if not found[0].get("pid"):
        return None, "pane process info carries no pid"
    return found[0]["pid"], found[0]


def busy_background_job(pane_id, uuid, agent, cfg):
    """Cmdline of a live background job the agent spawned, or None.

    An idle agent's children normally all date from session startup (MCP
    servers, helpers). A descendant that appeared BUSY_CHILD_MINUTES or more
    after the agent root started is work the agent launched and is still
    waiting on — a background monitor, `herdr wait`, a build. The pane only
    LOOKS idle; killing it would orphan that work and lose the wake-up, so
    such a pane is never hibernated automatically.
    """
    late = float(cfg["BUSY_CHILD_MINUTES"])
    if late <= 0:
        return None
    pid, _proc = find_agent_proc(pane_id, uuid, agent)
    if pid is None:
        return None
    root_up = proc_uptime_minutes(pid)
    if root_up is None:
        return None
    ignore = [t.strip().lower() for t in cfg["BUSY_IGNORE_TOKENS"].split()]
    ignore += [t.strip().lower() for t in AGENTS[agent]["helper_tokens"]]
    ignore = [t for t in ignore if t]
    procs = ps_snapshot()
    kids = descendants(pid, procs)
    # An agent can re-exec its own binary mid-session (codex's node wrapper
    # relaunches the vendored TUI on an in-place resume). Those processes
    # carry the pane's session id in their argv: they ARE the agent, not
    # background work — and helpers spawned right after them are startup
    # children of that re-exec, so the "late" clock runs from the youngest
    # such process, not from the original wrapper.
    epoch_up = root_up
    for child in kids:
        if uuid and uuid in procs.get(child, (0, 0, ""))[2]:
            up = proc_uptime_minutes(child)
            if up is not None:
                epoch_up = min(epoch_up, up)
    for child in kids:
        args = procs.get(child, (0, 0, ""))[2]
        if uuid and uuid in args:
            continue  # the agent's own (re-exec'd) session process
        if any(tok in args.lower() for tok in ignore):
            continue
        child_up = proc_uptime_minutes(child)
        if child_up is None:  # already gone — transient, not a background job
            continue
        if epoch_up - child_up >= late:
            return args[:60]
    return None


# ------------------------------------------------------------ classification

def classify(pane, tab_labels, cfg, state, self_pane):
    """-> (decision, reason). decision: hibernate | exempt | skip"""
    pane_id = pane["pane_id"]
    tab_id = pane.get("tab_id", "")
    label = tab_labels.get(tab_id, "") or pane.get("label", "")

    if pane_id in state:
        return "skip", "hibernated (stub waiting for Enter)"
    if pane_id == self_pane:
        return "exempt", "reaper's own pane"
    agent = pane.get("agent")
    if not agent:
        return "skip", "no agent in pane"
    if agent not in AGENTS:
        return "exempt", "agent %s has no proven resume path" % agent

    status = pane.get("agent_status", "unknown")
    if status in ("working", "blocked"):
        return "exempt", "status %s" % status

    pinned_tabs = cfg["PINNED_TABS"].split()
    marker = cfg["PIN_MARKER"]
    if tab_id in pinned_tabs:
        return "exempt", "pinned via PINNED_TABS"
    if marker and (marker in (tab_labels.get(tab_id, "") or "")
                   or marker in (pane.get("label") or "")):
        return "exempt", "pinned via %s label marker" % marker

    if status not in ("idle", "done"):
        return "skip", "status %s (need idle/done)" % status

    uuid = session_uuid(pane)
    if not uuid:
        return "skip", ("Herdr has not reported this pane's session id yet — "
                        "nothing to resume from, so never killing")
    if not re.fullmatch(UUID_RE, uuid):
        # `codex resume` also accepts session NAMES; a non-uuid could silently
        # resolve to a different session. Only kill what we can name exactly.
        return "skip", "session id %r is not a uuid — never killing" % uuid[:40]

    age = transcript_age_minutes(uuid, agent)
    if age is None:
        return "skip", "no transcript file found for %s — cannot verify/resume" % uuid
    threshold = float(cfg["HIBERNATE_AFTER_MINUTES"])
    if age < threshold:
        return "skip", "idle only %s (< %sm threshold)" % (fmt_idle(age), int(threshold))

    # Last (it costs a process-info call): an "idle" agent that spawned a
    # still-running background job is watching something, not idle.
    job = busy_background_job(pane_id, uuid, agent, cfg)
    if job:
        return "skip", "busy: background job running (%s)" % job

    return "hibernate", "idle %s" % fmt_idle(age)


# -------------------------------------------------------------- hibernation

def kill_tree(root, grace_seconds, protected, bin_name):
    """SIGTERM the whole tree rooted at `root`, SIGKILL survivors."""
    procs = ps_snapshot()
    if root not in procs:
        return False, "process %d already gone" % root
    if root in protected or root == 1:
        return False, "refusing to kill protected pid %d" % root
    if bin_name not in procs[root][2]:
        return False, "pid %d is not a %s process (%s)" % (
            root, bin_name, procs[root][2][:60])
    targets = [root] + descendants(root, procs)
    if protected & set(targets):
        return False, "own process inside kill tree; aborting"
    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.time() + grace_seconds
    while time.time() < deadline:
        if not any(os.path.exists("/proc/%d" % p) for p in targets):
            break
        time.sleep(0.25)
    for pid in targets:
        if os.path.exists("/proc/%d" % pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    return True, "%d processes" % len(targets)


