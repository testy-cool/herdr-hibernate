UUID_RE = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"

# Per-agent adapters — herdr's `agent` value -> how to measure idle time, find
# the process, and resume a killed session. Only agents listed here are ever
# hibernated: killing anything without a proven resume path would lose the
# conversation, so unknown agents are exempt.
#
#   transcript_glob  where the session's on-disk transcript lives ({sid} = the
#                    id Herdr reports in agent_session.value)
#   bin              executable name; used to spot the agent among the pane's
#                    foreground processes (argv[0] or argv[1] basename, so a
#                    `node .../bin/codex` wrapper matches too)
#   resume_argv      command that resumes session {sid} (run in the pane's cwd)
#   session_in_args  regex whose group(1) is the session id when it appears in
#                    a running process's args (resumed sessions only)
#   helper_tokens    cmdline substrings marking helper processes to ignore
#   replay_flags     flags captured from the killed process's argv and appended
#                    to resume_argv, so a resume keeps e.g. the model override
#   activity_globs   extra files whose timestamped writes count as session
#                    activity even though the main transcript is untouched
