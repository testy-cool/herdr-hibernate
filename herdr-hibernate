def cmd_scan(cfg=None):
    cfg = cfg or load_config()
    dry_run = cfg["DRY_RUN"] != "0"
    self_pane = os.environ.get("HERDR_PANE_ID", "")
    state = load_state()
    panes, tab_labels = collect_panes()
    # Always first: a dead stub (Herdr restart / reboot) must be re-armed before
    # anything else looks at this pane. Restore is never gated by DRY_RUN — it
    # only ever hands panes back the session they already lost.
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))

    mode = "DRY-RUN" if dry_run else "LIVE"
    log("--- scan (%s, threshold %sm, %d panes) ---" % (
        mode, cfg["HIBERNATE_AFTER_MINUTES"], len(panes)))
    count = 0
    for pane in panes:
        pane_id = pane["pane_id"]
        label = tab_labels.get(pane.get("tab_id", ""), "") or pane.get("label", "") or "(unnamed)"
        try:
            decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
        except Exception as exc:  # one bad pane must not kill the whole pass
            log("ERROR classifying %s (%s): %s" % (label, pane_id, exc))
            continue
        if decision == "hibernate":
            # One pane must never abort the pass: a tab closed mid-scan makes
            # the herdr call fail, and the remaining panes still need a look.
            try:
                hibernate_pane(pane, tab_labels, cfg, state,
                               reason.replace("idle ", ""), dry_run)
            except Exception as exc:
                log("ERROR hibernating %s (%s): %s" % (label, pane_id, exc))
            count += 1
        elif decision == "exempt":
            log("exempt %s (%s): %s" % (label, pane_id, reason))
        else:
            log("skip   %s (%s): %s" % (label, pane_id, reason))
    log("--- scan done: %d candidate(s)%s ---" % (
        count, " (dry-run, nothing touched)" if dry_run and count else ""))


def cmd_watch():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with file_lock(WATCH_LOCK_FILE, blocking=False) as acquired:
        if not acquired:
            old = watcher_pid()
            detail = " (pid %d)" % old if old else ""
            sys.exit("watch already running%s" % detail)
        with open(PID_FILE, "w") as fh:
            fh.write(str(os.getpid()))
        log("watch started (pid %d)" % os.getpid())
        try:  # a fresh watcher usually means a fresh Herdr: re-arm dead stubs now
            def startup_restore():
                state = load_state()
                if state:
                    panes, tab_labels = collect_panes()
                    restore_records(
                        panes, tab_labels, state,
                        forget_after=float(
                            load_config()["FORGET_AFTER_MINUTES"]))
            run_locked(startup_restore)
        except Exception as exc:
            log("startup restore failed: %s" % exc)
        try:
            while True:
                cfg = load_config()  # re-read each pass so DRY_RUN flips take effect
                try:
                    run_locked(cmd_scan, cfg)
                except Exception as exc:  # keep the loop alive
                    log("scan error: %s" % exc)
                time.sleep(float(cfg["SCAN_INTERVAL_SECONDS"]))
        finally:
            try:
                os.remove(PID_FILE)
            except OSError:
                pass


def cmd_now():
    """Hibernate the focused pane right now — what a keybinding calls.

    Runs detached from any pane, so it asks Herdr which pane has focus rather
    than trusting HERDR_PANE_ID. Feedback goes to a Herdr notification, since a
    detached command has nowhere to print.
    """
    log("now: on-demand hibernate requested (PATH=%s)"
        % os.environ.get("PATH", "")[:80], echo=False)
    try:
        pane = herdr("pane", "current").get("pane") or {}
    except RuntimeError as exc:
        toast("Hibernate failed", str(exc)[:120], sound="request")
        sys.exit(1)
    pane_id = pane.get("pane_id") or os.environ.get("HERDR_PANE_ID", "")
    if not pane_id:
        toast("Hibernate failed", "could not tell which pane has focus",
              sound="request")
        sys.exit(1)
    cmd_hibernate(pane_id, force=True, notify=True)


def cmd_hibernate(pane_id, force=False, notify=False):
    """Manual hibernate: bypasses the idle-time threshold, keeps all safety rules.

    `force` additionally skips the just-resumed guard and the background-job
    guard (an explicit request is not a mistake). The guard that refuses to
    kill a pane's own shell always applies — that one would close the tab.
    """
    cfg = load_config()
    dry_run = cfg["DRY_RUN"] != "0"

    def fail(msg):
        if notify:
            toast("Not hibernated", msg[:160], sound="request")
        sys.exit(msg)
    state = load_state()
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))
    pane = next((p for p in panes if p["pane_id"] == pane_id), None)
    if pane is None:
        fail("no such pane: %s" % pane_id)
    # A key press is aimed at whatever is focused, so never treat the focused
    # pane as "the reaper's own" — that exemption exists for the watcher only.
    self_pane = "" if force else os.environ.get("HERDR_PANE_ID", "")
    decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
    if decision == "exempt":
        fail("refusing: %s" % reason)
    if decision == "skip" and not reason.startswith("idle only"):
        # `--force` may override the background-job guard — an explicit request
        # is not a mistake — but nothing else.
        if force and reason.startswith("busy:"):
            log("force: overriding background-job guard on %s (%s)" % (
                pane_id, reason))
        else:
            fail("cannot hibernate: %s" % reason)
    uuid = session_uuid(pane)
    idle = fmt_idle(transcript_age_minutes(uuid, pane.get("agent", "claude")))
    before = len(state)
    hibernate_pane(pane, tab_labels, cfg, state, idle, dry_run, force=force)
    if dry_run:
        print("(dry-run — set DRY_RUN=0 in %s to hibernate for real)" % CONFIG_FILE)
    elif notify and len(state) == before:
        # hibernate_pane logged the reason and returned without acting.
        fail("hibernate refused — see %s" % LOG_FILE)


def cmd_restore(dry_run=False):
    """Re-arm every hibernated pane whose stub is gone. Safe to run any time."""
    state = load_state()
    if not state:
        print("nothing hibernated")
        return
    panes, tab_labels = collect_panes()
    n = restore_records(panes, tab_labels, state, dry_run=dry_run,
                        forget_after=float(load_config()["FORGET_AFTER_MINUTES"]))
    print("restore: %d pane(s) re-armed, %d hibernated record(s) tracked" % (
        n, len(load_state())))


def mark_workspace_hibernated(workspace_id, pane_ids, state):
    """Mark a fully parked workspace and attach marker ownership to records."""
    workspace = herdr("workspace", "get", workspace_id).get("workspace", {})
    label = workspace.get("label", "")
    marked = "💤 %s" % label if label and not label.startswith("💤") else None
    added = bool(marked)
    for pane_id in pane_ids:
        rec = state.get(pane_id)
        if not rec:
            continue
        rec["workspace_id"] = workspace_id
        rec["workspace_label"] = label
        rec["workspace_marker_added"] = added
        rec["marked_workspace_label"] = marked
    save_state(state)
    if marked:
        herdr("workspace", "rename", workspace_id, marked)


def cmd_hibernate_workspace(workspace_id, notify=False):
    """Hibernate every safely resumable agent in one workspace as a batch."""
    cfg = load_config()
    dry_run = cfg["DRY_RUN"] != "0"
    state = load_state()
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))
    targets, blockers = workspace_preflight(
        workspace_id, panes, tab_labels, cfg, state)
    if blockers:
        msg = "; ".join(blockers)
        if notify:
            toast("Project not hibernated", msg[:160], sound="request")
        sys.exit(msg)
    if not targets:
        msg = "no live resumable agents in workspace %s" % workspace_id
        if notify:
            toast("Nothing to hibernate", msg, sound="request")
        sys.exit(msg)

    parked = []
    for pane, idle in targets:
        if hibernate_pane(
                pane, tab_labels, cfg, state, idle, dry_run, force=True):
            parked.append(pane["pane_id"])
    if dry_run:
        print("(dry-run — workspace %s has %d safe agent pane%s)" % (
            workspace_id, len(targets), "" if len(targets) == 1 else "s"))
        return
    if len(parked) != len(targets):
        msg = "only %d of %d panes hibernated; see %s" % (
            len(parked), len(targets), LOG_FILE)
        if notify:
            toast("Project partly hibernated", msg[:160], sound="request")
        sys.exit(msg)

    all_parked = [pane_id for pane_id, _ in workspace_records(
        workspace_id, panes, state)]
    mark_workspace_hibernated(workspace_id, all_parked, state)
    freed = sum(state[pane_id].get("freed_mb", 0) for pane_id in all_parked)
    log("HIBERNATED workspace %s (%d pane%s, freed ~%dMB)" % (
        workspace_id, len(all_parked), "" if len(all_parked) == 1 else "s",
        freed))
    if notify:
        toast("Project hibernated", "%d agent pane%s · freed ~%dMB" % (
            len(all_parked), "" if len(all_parked) == 1 else "s", freed))


def cmd_wake_workspace(workspace_id, notify=False):
    """Press Enter in every armed stub belonging to one workspace."""
    cfg = load_config()
    state = load_state()
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))
    state = load_state()
    records = workspace_records(workspace_id, panes, state)
    if not records:
        msg = "no hibernated panes in workspace %s" % workspace_id
        if notify:
            toast("Nothing to wake", msg, sound="request")
        sys.exit(msg)
    dead = [pane_id for pane_id, _ in records
            if not stub_alive(pane_process_info(pane_id))]
    if dead:
        msg = "stubs are not armed: %s" % ", ".join(dead)
        if notify:
            toast("Project wake failed", msg[:160], sound="request")
        sys.exit(msg)

    if not release_workspace_marker(workspace_id, records, state):
        msg = "could not restore workspace label"
        if notify:
            toast("Project wake failed", msg, sound="request")
        sys.exit(msg)

    delay = max(0.0, float(cfg["WORKSPACE_WAKE_STAGGER_SECONDS"]))
    for i, (pane_id, _rec) in enumerate(records):
        herdr("pane", "send-keys", pane_id, "enter")
        if delay and i + 1 < len(records):
            time.sleep(delay)
    log("WAKING workspace %s (%d pane%s)" % (
        workspace_id, len(records), "" if len(records) == 1 else "s"))
    if notify:
        toast("Project waking", "%d agent pane%s resuming" % (
            len(records), "" if len(records) == 1 else "s"))


def cmd_workspace_toggle(workspace_id=None, notify=False):
    """Hibernate live agents, or wake the workspace when all are parked."""
    if not workspace_id:
        try:
            pane = herdr("pane", "current").get("pane") or {}
        except RuntimeError as exc:
            if notify:
                toast("Project toggle failed", str(exc)[:160], sound="request")
            sys.exit(str(exc))
        workspace_id = pane.get("workspace_id")
    if not workspace_id:
        sys.exit("could not determine focused workspace")

    state = load_state()
    panes, _tab_labels = collect_panes()
    scoped = [p for p in panes if p.get("workspace_id") == workspace_id]
    if any(p.get("agent") for p in scoped):
        return cmd_hibernate_workspace(workspace_id, notify=notify)
    if workspace_records(workspace_id, panes, state):
        return cmd_wake_workspace(workspace_id, notify=notify)
    msg = "workspace %s has no live or hibernated agents" % workspace_id
    if notify:
        toast("Nothing to toggle", msg, sound="request")
    sys.exit(msg)


def cmd_forget(pane_id, resumed=False):
    """Drop a pane's hibernation record and stub (called by the stub on resume)."""
    state = load_state()
    rec = state.get(pane_id)
    if rec:
        restore_owned_workspace_label(pane_id, rec, state)
    rec = state.pop(pane_id, None)
    save_state(state)
    remove_stub_file(pane_id)
    if resumed and awake_minutes(pane_id) is None:
        mark_awake(pane_id)
    if rec:
        log("%s %s (%s)" % ("RESUMED" if resumed else "FORGOT",
                            rec.get("label", "?"), pane_id), echo=not resumed)
    elif not resumed:
        print("no hibernation record for %s" % pane_id)


def cmd_label_awake(pane_id):
    """Restore this record's exact tool-owned tab label without clearing state."""
    # The stub runs this in the pane immediately before it execs the agent, so
    # it is the most accurate resume moment there is. Stamp it whatever else
    # happens below, because the agent starts either way.
    mark_awake(pane_id)
    state = load_state()
    rec = state.get(pane_id)
    if not rec:
        return
    try:
        pane = herdr("pane", "get", pane_id).get("pane", {})
    except RuntimeError:
        pane = {"tab_id": rec.get("tab_id", "")}
    if not restore_owned_tab_label(pane_id, pane, rec, state):
        sys.exit(1)
    if not restore_owned_workspace_label(pane_id, rec, state):
        sys.exit(1)


# The arming command is TYPED into the pane's shell, which echoes it, so its
# whole length is something the user has to read every time a pane is parked.
# A function keeps that echo to one legible line.
ARM_FUNCTION = "hb-arm"

SHELL_HOOK = """%s
# Arm this pane's hibernation stub. Herdr types `hb-arm <pane>` into the pane
# when parking it, so the name is chosen to be short: the shell echoes it, and
# the alternative is ninety characters of paths and escapes above the banner.
hb-arm() {
    local _hb_name="${1:-${HERDR_PANE_ID//[^A-Za-z0-9]/_}}"
    # A killed agent can leave the line discipline in raw mode.
    stty sane 2>/dev/null || true
    HERDR_HIBERNATE_STUB=1 bash "$HOME/.config/herdr-hibernate/panes/$_hb_name.sh"
}
# Re-arm a hibernated agent session when Herdr spawns a fresh shell in a pane.
# This is what makes hibernation survive a reboot: the stub process dies with
# Herdr, but its script lives on disk and this hook runs it again.
# Run it as a CHILD (no exec) so this shell stays the pane's shell — claude is
# then a grandchild, and killing it at the next hibernation cannot close the tab.
if [ -n "${HERDR_PANE_ID:-}" ] && [ -z "${HERDR_HIBERNATE_STUB:-}" ] \\
   && [[ $- == *i* ]]; then
    _hb_stub_file="$HOME/.config/herdr-hibernate/panes/${HERDR_PANE_ID//[^A-Za-z0-9]/_}.sh"
    if [ -s "$_hb_stub_file" ]; then
        HERDR_HIBERNATE_STUB=1 bash "$_hb_stub_file"
    fi
    unset _hb_stub_file
fi
# <<< herdr-hibernate pane stub hook <<<
""" % SHELL_HOOK_MARK


def install_shell_hook(rcs=None):
    """Add (or refresh) the shell hook that re-arms stubs in fresh shells.

    Every rc that exists gets it, plus any that already carries the marker: a
    pane's shell is whichever one Herdr spawned, and a hook that is only half
    installed means arming works in one shell and not the other.
    """
    if rcs is None:
        rcs = [rc for rc in SHELL_RC_FILES if os.path.exists(rc)] or SHELL_RC_FILES
    global _arm_in_rc
    _arm_in_rc = None  # the answer changes underneath us right here
    return "; ".join(_install_shell_hook_in(rc) for rc in rcs)


def _install_shell_hook_in(rc):
    try:
        with open(rc, encoding="utf-8") as fh:
            body = fh.read()
    except OSError:
        body = ""
    if SHELL_HOOK_MARK in body:
        start = body.index(SHELL_HOOK_MARK)
        end = body.index(SHELL_HOOK_END, start)
        end = body.index("\n", end) + 1
        if body[start:end] == SHELL_HOOK:
            return "shell hook already installed in %s" % rc
        body = body[:start] + SHELL_HOOK + body[end:]
        action = "updated"
    else:
        body = body.rstrip("\n") + "\n\n" + SHELL_HOOK
        action = "installed"
    with open(rc, "w", encoding="utf-8") as fh:
        fh.write(body)
    return "%s shell hook in %s" % (action, rc)


def cmd_status():
    cfg = load_config()
    state = load_state()
    self_pane = os.environ.get("HERDR_PANE_ID", "")
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state, dry_run=True)
    threshold = cfg["HIBERNATE_AFTER_MINUTES"]
    print("DRY_RUN=%s  threshold=%sm  pin_marker=%s  pinned_tabs=[%s]\n" % (
        cfg["DRY_RUN"], threshold, cfg["PIN_MARKER"], cfg["PINNED_TABS"]))
    fmt = "%-22s %-28s %-8s %-7s %s"
    print(fmt % ("PANE", "TAB LABEL", "STATUS", "IDLE", "CLASSIFICATION"))
    for pane in panes:
        pane_id = pane["pane_id"]
        label = (tab_labels.get(pane.get("tab_id", ""), "")
                 or pane.get("label", "") or "(unnamed)")[:28]
        agent = pane.get("agent") or ""
        status = pane.get("agent_status", "-") if agent else "-"
        uuid = session_uuid(pane)
        idle = (fmt_idle(transcript_age_minutes(uuid, agent))
                if uuid and agent in AGENTS else "-")
        decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
        tag = {"hibernate": "WOULD HIBERNATE", "exempt": "EXEMPT — " + reason,
               "skip": reason}[decision]
        if decision == "hibernate":
            # Show the guards hibernate_pane applies, so this table cannot
            # promise a kill that would actually be refused.
            try:
                pid, _ = find_agent_proc(pane_id, uuid, agent)
            except RuntimeError:
                pid = None
            if pid:
                info = pane_process_info(pane_id)
                up = agent_age_minutes(pid, pane_id)
                if info and pid == info.get("shell_pid"):
                    tag = "PROTECTED — %s is the pane's shell" % agent
                elif up is not None and up < float(threshold):
                    tag = "PROTECTED — %s started %s ago" % (agent, fmt_idle(up))
        print(fmt % (pane_id, label, status, idle, tag))
    state = load_state()
    if state:
        print("\nhibernated:")
        for pane_id, rec in state.items():
            armed = "stub armed" if stub_alive(pane_process_info(pane_id)) \
                else "STUB DEAD — run `herdr-hibernate restore`"
            print("  %s  %-28s freed ~%dMB at %s  [%s]" % (
                pane_id, rec["label"][:28], rec["freed_mb"], rec["at"], armed))


def watcher_pid():
    """PID of a live watcher, or None. Survives reboots reusing the pid."""
    try:
        pid = int(open(PID_FILE).read().strip())
    except (OSError, ValueError):
        return None
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            if b"herdr-hibernate" in fh.read():
                return pid
    except OSError:
        pass
    return None


def cmd_ensure():
    """Start the watcher if it is not already running (for shell rc hooks)."""
    with file_lock(OPERATION_LOCK_FILE):
        if watcher_lock_active():
            return
        proc = subprocess.Popen(
            [SELF, "watch"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True)
        deadline = time.time() + 5
        while time.time() < deadline:
            if watcher_lock_active():
                log("ensure: watcher was not running, started pid %d" % proc.pid,
                    echo=False)
                return
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        log("ensure: watcher failed to acquire its lock", echo=False)


def systemd_available():
    try:
        return subprocess.run(["systemctl", "--user", "status"],
                              capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def cmd_install():
    self_path = SELF
    print(install_shell_hook())
    if systemd_available():
        os.makedirs(os.path.dirname(SYSTEMD_UNIT), exist_ok=True)
        env_lines = "".join(
            'Environment="%s=%s"\n' % (k, os.environ[k])
            for k in ("HERDR_ENV", "HERDR_WORKSPACE_ID", "HERDR_TAB_ID", "HERDR_PANE_ID")
            if k in os.environ)
        with open(SYSTEMD_UNIT, "w") as fh:
            fh.write("[Unit]\nDescription=herdr-hibernate idle-tab reaper\n\n"
                     "[Service]\nExecStart=%s watch\nRestart=on-failure\n%s\n"
                     "[Install]\nWantedBy=default.target\n" % (self_path, env_lines))
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now",
                        "herdr-hibernate.service"], check=True)
        print("installed systemd user service: herdr-hibernate.service")
        return
    # WSL2 fallback: detached nohup loop inheriting this pane's Herdr env.
    old = watcher_pid()
    if old:
        sys.exit("already installed and running (pid %d)" % old)
    proc = subprocess.Popen(
        ["nohup", self_path, "watch"],
        stdout=open(os.devnull, "w"), stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL, start_new_session=True)
    print("systemd user units unavailable — started nohup watcher (pid %d)." % proc.pid)
    print("It inherits this pane's Herdr env; re-run install after a Herdr restart.")
    print("Log: %s" % LOG_FILE)


def cmd_uninstall():
    stopped = False
    if os.path.exists(SYSTEMD_UNIT):
        subprocess.run(["systemctl", "--user", "disable", "--now",
                        "herdr-hibernate.service"], capture_output=True)
        os.remove(SYSTEMD_UNIT)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        print("removed systemd user service")
        stopped = True
    if os.path.exists(PID_FILE):
        try:
            pid = int(open(PID_FILE).read().strip())
            if os.path.exists("/proc/%d" % pid):
                os.kill(pid, signal.SIGTERM)
                print("stopped watcher (pid %d)" % pid)
                stopped = True
        except (ValueError, ProcessLookupError):
            pass
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
    if not stopped:
        print("nothing to uninstall")


def main():
    if os.environ.get("HERDR_ENV") != "1" and "HERDR_PANE_ID" not in os.environ:
        # herdr CLI may still reach the session, but warn: self-pane exemption
        # cannot work without HERDR_PANE_ID.
        print("warning: not inside a Herdr-managed pane (HERDR_ENV != 1)",
              file=sys.stderr)
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip())
        sys.exit(2)
    cmd = args[0]
    if cmd == "watch":
        cmd_watch()
    elif cmd == "scan":
        run_locked(cmd_scan)
    elif cmd == "hibernate":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate hibernate <pane_id> [--force]")
        run_locked(cmd_hibernate, args[1], force="--force" in args)
    elif cmd == "now":
        run_locked(cmd_now)
    elif cmd == "hibernate-workspace":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate hibernate-workspace <workspace_id>")
        run_locked(cmd_hibernate_workspace, args[1])
    elif cmd == "wake-workspace":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate wake-workspace <workspace_id>")
        run_locked(cmd_wake_workspace, args[1])
    elif cmd == "workspace-toggle":
        run_locked(cmd_workspace_toggle,
                   args[1] if len(args) > 1 else None, notify=True)
    elif cmd == "restore":
        run_locked(cmd_restore, dry_run="--dry-run" in args)
    elif cmd == "forget":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate forget <pane_id> [--resumed]")
        run_locked(cmd_forget, args[1], resumed="--resumed" in args)
    elif cmd == "label-awake":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate label-awake <pane_id>")
        run_locked(cmd_label_awake, args[1])
    elif cmd == "status":
        cmd_status()
    elif cmd == "ensure":
        cmd_ensure()
    elif cmd == "install":
        cmd_install()
    elif cmd == "uninstall":
        cmd_uninstall()
    else:
        sys.exit("unknown command: %s\n%s" % (cmd, __doc__.strip()))


if __name__ == "__main__":
    main()
