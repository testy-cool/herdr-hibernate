def pane_file(pane_id):
    """Path of the durable stub script for a pane (must match the .bashrc hook)."""
    return os.path.join(PANES_DIR, re.sub(r"[^A-Za-z0-9]", "_", pane_id) + ".sh")


def since_minutes(at):
    """Minutes since a 'YYYY-mm-dd HH:MM:SS' timestamp, or None if unparseable."""
    try:
        return (time.time() - time.mktime(
            time.strptime(at, "%Y-%m-%d %H:%M:%S"))) / 60.0
    except (ValueError, TypeError):
        return None


def since_str(at):
    """Human age of a 'YYYY-mm-dd HH:MM:SS' timestamp."""
    mins = since_minutes(at)
    return "?" if mins is None else fmt_idle(mins)


def resume_argv(rec):
    """The argv that resumes a record's session, e.g. ['codex', 'resume', <id>].

    Prefers the argv captured at hibernation time (which carries replayed
    flags); falls back to the adapter template for records written by older
    versions, which were always Claude.
    """
    saved = rec.get("resume")
    if isinstance(saved, list) and saved:
        return saved
    agent = rec.get("agent", "claude")
    spec = AGENTS.get(agent)
    if spec is None:
        # Record from a newer version (or foreign data): never guess a resume
        # command for an unknown agent — surface the id instead.
        return ["echo", "cannot auto-resume unknown agent %r — session %s"
                % (agent, rec.get("uuid"))]
    cwd = rec.get("cwd") or os.path.expanduser("~")
    return [tok.format(sid=rec["uuid"], cwd=cwd) for tok in spec["resume_argv"]]


def write_stub_file(pane_id, rec):
    """(Re)write the pane's stub script from its state record. Returns its path."""
    os.makedirs(PANES_DIR, mode=0o700, exist_ok=True)
    banner = "💤 hibernated %s ago (freed ~%dMB) — press Enter to resume" % (
        since_str(rec.get("at", "")), rec.get("freed_mb", 0))
    agent = rec.get("agent", "claude")
    # Short id and a ~-relative path: the full uuid wrapped this line onto a
    # third row for no gain, and Ctrl-C prints the exact resume command anyway.
    subtitle = "%s %s · %s · Ctrl-C for a plain shell" % (
        agent, rec["uuid"].split("-")[0], tilde(rec.get("cwd", "")))
    # Re-read on every rewrite (the watcher rewrites each stub every scan) so a
    # session that kept talking before it was parked shows its real last words.
    turns = last_exchange(rec["uuid"], agent) if _excerpt_shown else []
    # Both speakers share one label column, so a long Herdr agent name would
    # otherwise push the reply's text out of line with the prompt's.
    label = (rec.get("agent_name") or agent)[:10]
    resume = resume_argv(rec)
    path = pane_file(pane_id)
    body = STUB_TEMPLATE.format(
        pane_id=shlex.quote(pane_id),
        uuid=shlex.quote(rec["uuid"]),
        resume_cmd=" ".join(shlex.quote(t) for t in resume),
        resume_display=shlex.quote(" ".join(shlex.quote(t) for t in resume)),
        cwd=shlex.quote(rec.get("cwd") or os.path.expanduser("~")),
        banner=shlex.quote(banner),
        subtitle=shlex.quote(subtitle),
        excerpt=render_excerpt(turns, label),
        tool=shlex.quote(SELF),
    )
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    # Owner-only: this file holds a slice of the conversation now, not just a
    # session id, and transcripts routinely contain keys the user pasted in.
    os.chmod(tmp, 0o700)
    os.replace(tmp, path)
    return path


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home) else path


def render_excerpt(turns, label):
    """The shell lines that print an excerpt, ready to drop into the stub."""
    if not turns:
        return ":"  # nothing to say; keep the template a valid statement
    pad = str(max(3, len(label)))
    lines = ["printf '\\n'"]
    for role, text in turns:
        lines.append("_hb_turn %s %s %s %s" % (
            shlex.quote("you" if role == "user" else label),
            shlex.quote(text), _excerpt_lines, pad))
    return "\n    ".join(lines)


def remove_stub_file(pane_id):
    try:
        os.remove(pane_file(pane_id))
    except OSError:
        pass


def awake_file(pane_id):
    """Path of the marker recording when this pane's agent last came back."""
    return pane_file(pane_id)[:-len(".sh")] + ".awake"


def mark_awake(pane_id):
    """Stamp the moment an agent came back to a pane.

    The stub hands over with `exec`, so the resumed agent inherits the stub's
    pid *and* its start time: /proc reports a session that returned three
    seconds ago as being as old as the park. This file's mtime is the only
    honest record of when the agent actually started, and the just-resumed
    guard is worthless without it.
    """
    path = awake_file(pane_id)
    try:
        os.makedirs(PANES_DIR, mode=0o700, exist_ok=True)
        with open(path, "w"):
            pass
        os.chmod(path, 0o600)  # it sits among the stubs, which hold conversation
        os.utime(path, None)
    except OSError:
        pass


def awake_minutes(pane_id):
    """Minutes since this pane's agent came back, or None if never recorded."""
    try:
        return max(0.0, (time.time() - os.path.getmtime(awake_file(pane_id)))
                   / 60.0)
    except OSError:
        return None


def agent_age_minutes(pid, pane_id):
    """How long the agent in a pane has really been running.

    Neither source is trustworthy alone. /proc over-reports after a resume, and
    the marker is missing for an agent the user started by hand or one that
    replaced a resumed session. Whichever is smaller is the safe answer.
    """
    ages = [a for a in (proc_uptime_minutes(pid), awake_minutes(pane_id))
            if a is not None]
    return min(ages) if ages else None


def stub_command(pane_id, info=None, plain=False):
    """Command that arms the pane's stub as a CHILD of the pane shell.

    Never `exec` here: the pane's own shell has to outlive both the stub and
    the claude it resumes, otherwise the next hibernation closes the tab.
    """
    # This text is TYPED into the pane's shell, so the shell echoes it and the
    # user reads it every time a pane is parked. Prefer the one-word function
    # the shell hook defines; fall back to spelling it out when that function
    # is not actually in the user's rc, because an unarmed pane would be
    # re-armed with the same missing command on every scan, forever.
    stub = pane_file(pane_id)
    if not plain and pane_shell_has_arm(info if info is not None
                                        else pane_process_info(pane_id)):
        return "%s %s" % (ARM_FUNCTION,
                          shlex.quote(os.path.basename(stub)[:-len(".sh")]))
    # `stty sane` is the one part worth spelling out: a killed agent can leave
    # the line discipline in raw mode, and the shell has to be able to take the
    # command at all.
    return "stty sane 2>/dev/null || true; bash %s" % shlex.quote(stub)


def pane_shell_has_arm(info):
    """Can the shell sitting in THIS pane run the hook's arming function?

    Asking the rc file alone is not enough, and getting that wrong left a pane
    unarmed: a shell keeps whatever rc it read at startup, so a hook installed
    five minutes ago is invisible to every shell that was already running. The
    shell therefore has to be one we install into, and it has to have started
    after its own rc was last written.
    """
    procs = (info or {}).get("foreground_processes") or []
    shell_pid = (info or {}).get("shell_pid")
    name = next((p.get("name") for p in procs if p.get("pid") == shell_pid), None)
    rc = SHELL_RC_FOR.get(name)
    if rc is None or not shell_pid:
        return False
    try:
        with open(rc, encoding="utf-8", errors="replace") as fh:
            if "%s()" % ARM_FUNCTION not in fh.read():
                return False
        written = os.stat(rc).st_mtime
    except OSError:
        return False
    age = proc_uptime_minutes(shell_pid)
    if age is None:
        return False
    return (time.time() - age * 60.0) > written


def pane_process_info(pane_id):
    try:
        return herdr("pane", "process-info", "--pane", pane_id)["process_info"]
    except (RuntimeError, KeyError, TypeError):
        return None


# "hibernate-stub" is the arg0 of stubs planted by versions before stub files
# existed; those are still valid waiting stubs and must not be double-planted.
STUB_MARKERS = (PANES_DIR, "hibernate-stub")


def stub_alive(info):
    """True if this pane's foreground process is a herdr-hibernate stub."""
    if not info:
        return False
    return any(any(m in (p.get("cmdline") or "") for m in STUB_MARKERS)
               for p in info.get("foreground_processes") or [])


def bare_shell(info):
    """True if the pane sits at an idle shell prompt with nothing running.

    Deliberately strict: the single foreground process must be the shell itself
    with no arguments, so a pane running `bash -c ...` is never mistaken for an
    empty prompt and never has a stub typed into it.
    """
    if not info:
        return False
    procs = info.get("foreground_processes") or []
    if len(procs) != 1:
        return False
    proc = procs[0]
    if proc.get("name") not in ("bash", "sh", "zsh", "fish", "dash"):
        return False
    argv = proc.get("argv") or []
    return len(argv) <= 1 and proc.get("pid") == info.get("shell_pid")


def toast(title, body="", sound="none"):
    """Best-effort Herdr notification — the only feedback a keybinding can give."""
    args = ["notification", "show", title, "--position", "top-right",
            "--sound", sound]
    if body:
        args += ["--body", body]
    try:
        herdr(*args)
    except (RuntimeError, OSError):
        pass


def build_resume(agent, sid, proc, cwd):
    """Resume argv for a session, with whitelisted flags replayed from the
    process being killed (so e.g. a codex model override survives resume)."""
    spec = AGENTS[agent]
    base = [tok.format(sid=sid, cwd=cwd) for tok in spec["resume_argv"]]
    keep = spec["replay_flags"]
    argv = (proc or {}).get("argv") or []
    if not keep or not argv:
        return base
    start = 0
    for i, tok in enumerate(argv):
        if os.path.basename(tok) in (spec["bin"], spec["bin"] + ".js"):
            start = i + 1
            break
    bools = spec.get("replay_bool_flags", ())
    tail, extra, i = argv[start:], [], 0
    while i < len(tail):
        tok = tail[i]
        if tok in keep and i + 1 < len(tail):
            extra += [tok, tail[i + 1]]
            i += 2
        elif "=" in tok and tok.split("=", 1)[0] in keep:  # --model=x form
            extra.append(tok)
            i += 1
        elif tok in bools:
            extra.append(tok)
            i += 1
        else:
            i += 1
    return base + extra


def record_marked_label(rec):
    """The exact label this record owns, including backward compatibility."""
    if rec.get("marker_added") is False:
        return None
    marked = rec.get("marked_label")
    if marked:
        return marked
    label = rec.get("label", "")
    if label and not label.startswith("💤"):
        return "💤 %s" % label
    return None


def marker_record(label, tab_id, state):
    """Return (original, marked, added) for a new hibernation record."""
    for rec in state.values():
        if rec.get("tab_id") != tab_id:
            continue
        marked = record_marked_label(rec)
        if marked and label == marked:
            return rec.get("label", label), marked, True
    if label and not label.startswith("💤"):
        return label, "💤 %s" % label, True
    return label, None, False


def restore_owned_tab_label(pane_id, pane, rec, state):
    """Restore our exact tab marker. False means retry before deleting the record."""
    marked = record_marked_label(rec)
    if not marked:
        return True
    tab_id = pane.get("tab_id") or rec.get("tab_id", "")
    if not tab_id:
        return False
    if any(other_id != pane_id
           and other.get("tab_id") == tab_id
           and record_marked_label(other) == marked
           for other_id, other in state.items()):
        return True  # another pane in this tab is still hibernated
    try:
        current = herdr("tab", "get", tab_id).get("tab", {}).get("label", "")
    except RuntimeError as exc:
        log("LABEL retry %s (%s): %s" % (rec.get("label", "?"), pane_id, exc),
            echo=False)
        return False
    if current != marked:
        return True  # the user changed it, or this marker is not ours
    try:
        herdr("tab", "rename", tab_id, rec.get("label", ""))
    except RuntimeError as exc:
        log("LABEL retry %s (%s): %s" % (rec.get("label", "?"), pane_id, exc),
            echo=False)
        return False
    return True


def record_marked_workspace_label(rec):
    if rec.get("workspace_marker_added") is not True:
        return None
    return rec.get("marked_workspace_label")


def restore_owned_workspace_label(pane_id, rec, state):
    """Restore an exact workspace marker after its last parked pane wakes."""
    marked = record_marked_workspace_label(rec)
    workspace_id = rec.get("workspace_id", "")
    if not marked or not workspace_id:
        return True
    if any(other_id != pane_id
           and other.get("workspace_id") == workspace_id
           and record_marked_workspace_label(other) == marked
           for other_id, other in state.items()):
        return True
    try:
        current = herdr("workspace", "get", workspace_id).get(
            "workspace", {}).get("label", "")
    except RuntimeError as exc:
        log("WORKSPACE LABEL retry %s: %s" % (workspace_id, exc), echo=False)
        return False
    if current != marked:
        return True
    try:
        herdr("workspace", "rename", workspace_id,
              rec.get("workspace_label", ""))
    except RuntimeError as exc:
        log("WORKSPACE LABEL retry %s: %s" % (workspace_id, exc), echo=False)
        return False
    return True


def restore_owned_agent_name(pane_id, pane, rec):
    """Restore a Herdr agent name unless someone already chose another one."""
    desired = rec.get("agent_name")
    current = pane.get("name")
    if not desired or current:
        return True
    try:
        herdr("agent", "rename", pane_id, desired)
    except RuntimeError as exc:
        log("AGENT NAME retry %s: %s" % (pane_id, exc), echo=False)
        return False
    return True


def release_workspace_marker(workspace_id, records, state):
    """Release one workspace-level marker before a deliberate project wake."""
    owned = [rec for _pane_id, rec in records
             if rec.get("workspace_id") == workspace_id
             and record_marked_workspace_label(rec)]
    if not owned:
        return True
    rec = owned[0]
    marked = record_marked_workspace_label(rec)
    try:
        current = herdr("workspace", "get", workspace_id).get(
            "workspace", {}).get("label", "")
        if current == marked:
            herdr("workspace", "rename", workspace_id,
                  rec.get("workspace_label", ""))
    except RuntimeError as exc:
        log("WORKSPACE LABEL retry %s: %s" % (workspace_id, exc), echo=False)
        return False
    for owned_rec in owned:
        owned_rec["workspace_marker_added"] = False
        owned_rec["marked_workspace_label"] = None
    save_state(state)
    return True


def workspace_preflight(workspace_id, panes, tab_labels, cfg, state):
    """Return safe hibernation targets and blockers for an all-project run."""
    targets, blockers = [], []
    for pane in panes:
        if pane.get("workspace_id") != workspace_id:
            continue
        pane_id = pane["pane_id"]
        if pane_id in state:
            continue
        if not pane.get("agent"):
            info = pane_process_info(pane_id)
            if bare_shell(info):
                continue
            blockers.append("%s: non-agent process is running" % pane_id)
            continue

        decision, reason = classify(pane, tab_labels, cfg, state, "")
        allowed = (decision == "hibernate"
                   or (decision == "skip" and reason.startswith("idle only")))
        if not allowed:
            blockers.append("%s: %s" % (pane_id, reason))
            continue

        uuid = session_uuid(pane)
        pid, proc = find_agent_proc(pane_id, uuid, pane.get("agent"))
        if pid is None:
            blockers.append("%s: %s" % (pane_id, proc))
            continue
        info = pane_process_info(pane_id)
        if info and pid == info.get("shell_pid"):
            blockers.append("%s: agent is the pane shell" % pane_id)
            continue
        idle = fmt_idle(transcript_age_minutes(
            uuid, pane.get("agent", "claude")))
        targets.append((pane, idle))
    return targets, blockers


def hibernate_pane(pane, tab_labels, cfg, state, idle_str, dry_run, force=False):
    pane_id = pane["pane_id"]
    tab_id = pane.get("tab_id", "")
    label = tab_labels.get(tab_id, "") or pane.get("label", "") or pane_id
    uuid = session_uuid(pane)
    agent = pane.get("agent")
    if agent not in AGENTS:
        log("SKIP %s (%s): agent %s has no proven resume path" % (
            label, pane_id, agent))
        return False
    # classify() proved a session id earlier, but for grok it is re-resolved
    # live (registry lookup) and could have vanished in between. A kill with
    # no resumable id must never happen, whatever the caller checked.
    if not uuid or not re.fullmatch(UUID_RE, uuid):
        log("SKIP %s (%s): no valid session id at kill time — never killing"
            % (label, pane_id))
        return False

    pid, proc = find_agent_proc(pane_id, uuid, agent)
    if pid is None:
        log("SKIP %s (%s): %s" % (label, pane_id, proc))
        return False

    # Killing the pane's own shell closes the tab. That is never acceptable —
    # it can happen if the agent replaced the shell (an `exec claude` stub).
    info = pane_process_info(pane_id)
    if info and pid == info.get("shell_pid"):
        log("SKIP %s (%s): %s is the pane's shell — killing it would close "
            "the tab" % (label, pane_id, agent))
        return False

    # A session resumed a moment ago still has an old last-message timestamp
    # (loading history writes nothing), so it looks ancient. It cannot be idler
    # than its own agent is old.
    up = agent_age_minutes(pid, pane_id)
    threshold = float(cfg["HIBERNATE_AFTER_MINUTES"])
    if not force and up is not None and up < threshold:
        log("SKIP %s (%s): %s only started %s ago (likely just resumed)" % (
            label, pane_id, agent, fmt_idle(up)))
        return False

    rss_mb = tree_rss_mb(pid, ps_snapshot())

    if dry_run:
        log("WOULD hibernate %s (%s, idle %s, ~%dMB, pid %d)" % (
            label, pane_id, idle_str, rss_mb, pid))
        return False

    # Re-verify status just before killing — it may have started working.
    fresh = herdr("pane", "get", pane_id).get("pane", {})
    if fresh.get("agent_status") not in ("idle", "done"):
        log("ABORT %s (%s): status changed to %s" % (
            label, pane_id, fresh.get("agent_status")))
        return False

    ok, detail = kill_tree(pid, float(cfg["KILL_GRACE_SECONDS"]),
                           own_ancestors(), AGENTS[agent]["bin"])
    if not ok:
        log("ABORT %s (%s): %s" % (label, pane_id, detail))
        return False

    time.sleep(1.0)  # let the pane shell come back to its prompt
    cwd = pane.get("cwd") or os.path.expanduser("~")
    original_label, marked_label, marker_added = marker_record(label, tab_id, state)
    rec = {
        "uuid": uuid, "agent": agent,
        "resume": build_resume(agent, uuid, proc, cwd),
        "agent_name": pane.get("name"),
        "workspace_id": pane.get("workspace_id", ""),
        "tab_id": tab_id, "label": original_label, "cwd": cwd,
        "marker_added": marker_added, "marked_label": marked_label,
        "freed_mb": rss_mb, "at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    # Record + stub file first: if anything below fails, the .bashrc hook and
    # `restore` can still bring this pane back.
    state[pane_id] = rec
    save_state(state)
    write_stub_file(pane_id, rec)
    command = stub_command(pane_id, info)
    rec["armed_with_alias"] = command.startswith(ARM_FUNCTION + " ")
    save_state(state)
    herdr("pane", "run", pane_id, command)
    try:
        if marked_label and label != marked_label:
            herdr("tab", "rename", tab_id, marked_label)
    except RuntimeError:
        pass
    log("HIBERNATED %s (%s, idle %s, freed ~%dMB, killed tree of pid %d [%s])" % (
        label, pane_id, idle_str, rss_mb, pid, detail))
    return True


def forget_record(pane_id, state, why):
    """Erase everything this tool knows about a pane. Nothing is archived.

    Deliberately no graveyard file: once a tab is gone, its session id, label
    and cwd leave the tool entirely. The transcript itself is Claude Code's
    own data under ~/.claude/projects and is never touched here.
    """
    rec = state.get(pane_id)
    if rec:
        # A workspace marker belongs to the parked-record set, not forever to
        # the workspace. Best effort is correct here: if the workspace itself
        # was closed there is no label left to restore, but we must still erase
        # the now-useless record.
        restore_owned_workspace_label(pane_id, rec, state)
    rec = state.pop(pane_id, None)
    save_state(state)
    remove_stub_file(pane_id)
    log("FORGOT %s (%s): %s" % (rec.get("label", "?") if rec else "?",
                                pane_id, why))


def gc_stub_files(state, threshold=None):
    """Delete stub scripts that no longer belong to a tracked pane.

    Resume markers belong to no record by design — the record is gone by the
    time one is written — so they age out instead, well past the point where
    the just-resumed guard would still consult them.
    """
    if threshold is None:
        threshold = float(load_config()["HIBERNATE_AFTER_MINUTES"])
    expected = {os.path.basename(pane_file(p)) for p in state}
    try:
        names = os.listdir(PANES_DIR)
    except OSError:
        return
    for name in names:
        if name.endswith(".awake"):
            path = os.path.join(PANES_DIR, name)
            try:
                if (time.time() - os.path.getmtime(path)) / 60.0 > threshold * 2:
                    os.remove(path)
            except OSError:
                pass
            continue
        if name.endswith(".sh") and name not in expected:
            try:
                os.remove(os.path.join(PANES_DIR, name))
                log("GC stub script %s (no matching pane record)" % name,
                    echo=False)
            except OSError:
                pass


def match_pane(pane_id, rec, panes):
    """Find the pane a record belongs to, tolerating id churn across restarts."""
    by_id = {p["pane_id"]: p for p in panes}
    if pane_id in by_id:
        return by_id[pane_id]
    # Herdr can renumber panes across restarts: fall back to the tab, then to
    # the tab label we stamped with 💤 plus the recorded cwd.
    for pane in panes:
        if rec.get("tab_id") and pane.get("tab_id") == rec["tab_id"]:
            return pane
    for pane in panes:
        if (not pane.get("agent") and rec.get("cwd")
                and pane.get("cwd") == rec["cwd"]
                and (pane.get("label") or "").lstrip("💤 ") == rec.get("label")):
            return pane
    return None


def restore_records(panes, tab_labels, state, dry_run=False, forget_after=15.0):
    """Re-arm hibernated panes whose stub died (Herdr restart / reboot / kill).

    This is what makes hibernation survive a machine restart: the stub is just
    a process, so it dies with Herdr — but the state record and the pane's stub
    script both live on disk, so the pane can always be re-armed.
    """
    restored = 0
    for pane_id in list(state):
        rec = state[pane_id]
        label = rec.get("label", "?")
        pane = match_pane(pane_id, rec, panes)
        if pane is None:
            # Tab closed -> forget it completely. The grace window exists only
            # so a half-started Herdr (incomplete pane list) cannot erase tabs
            # that are actually still open.
            gone_for = since_minutes(rec.get("missing_since"))
            if dry_run:
                log("WOULD forget %s (%s): pane gone%s" % (
                    label, pane_id,
                    "" if gone_for is None else " for %s" % fmt_idle(gone_for)))
            elif forget_after <= 0 or (gone_for is not None
                                       and gone_for >= forget_after):
                forget_record(pane_id, state, "tab closed")
            elif gone_for is None:
                rec["missing_since"] = time.strftime("%Y-%m-%d %H:%M:%S")
                save_state(state)
                log("MISSING %s (%s): pane gone — forgetting in %dm unless it "
                    "comes back" % (label, pane_id, forget_after), echo=False)
            continue
        if rec.pop("missing_since", None) is not None:
            save_state(state)  # pane came back — cancel the pending forget
        if transcript_age_minutes(rec["uuid"], rec.get("agent", "claude")) is None:
            # No transcript means nothing to resume — the record is dead weight.
            if not dry_run:
                forget_record(pane_id, state, "session transcript is gone")
            continue

        live_id = pane["pane_id"]
        if live_id != pane_id and not dry_run:  # pane renumbered — re-key it
            log("REKEY %s: %s -> %s" % (label, pane_id, live_id))
            remove_stub_file(pane_id)
            del state[pane_id]
            rec["tab_id"] = pane.get("tab_id", rec.get("tab_id", ""))
            rec["workspace_id"] = pane.get(
                "workspace_id", rec.get("workspace_id", ""))
            state[live_id] = rec
            save_state(state)
            pane_id = live_id

        info = pane_process_info(pane_id)
        if stub_alive(info):
            # Healthy: a stub is sitting there waiting for Enter. Still make
            # sure its script exists on disk, so the .bashrc hook can re-arm
            # the pane by itself after the next reboot.
            # Rewriting is safe while the stub runs: write_stub_file replaces
            # the file atomically, so the running bash keeps its old inode.
            if not dry_run:
                fresh = not os.path.exists(pane_file(pane_id))
                write_stub_file(pane_id, rec)
                if fresh:
                    log("ARMED %s (%s): wrote stub script for reboot recovery"
                        % (label, pane_id), echo=False)
            continue
        if pane.get("agent") == rec.get("agent", "claude"):
            # The agent is live in the pane again — the stub did its job.
            # (Accept any session uuid: right after a resume Herdr may not have
            # picked the session identity up yet.)
            if not dry_run:
                if not restore_owned_tab_label(pane_id, pane, rec, state):
                    continue
                if not restore_owned_workspace_label(pane_id, rec, state):
                    continue
                if not restore_owned_agent_name(pane_id, pane, rec):
                    continue
                log("RESUMED %s (%s)" % (label, pane_id), echo=False)
                if awake_minutes(pane_id) is None:
                    mark_awake(pane_id)
                del state[pane_id]
                remove_stub_file(pane_id)
                save_state(state)
            continue
        if pane.get("agent"):
            if not dry_run:
                forget_record(pane_id, state,
                              "pane reused by agent %s" % pane.get("agent"))
            continue
        if not bare_shell(info):
            log("SKIP restore %s (%s): pane is busy, will retry next pass" % (
                label, pane_id))
            continue

        # Pane is an empty shell but we still owe it a session: re-arm it.
        if dry_run:
            log("WOULD restore %s (%s): stub is dead, session %s" % (
                label, pane_id, rec["uuid"]))
            continue
        write_stub_file(pane_id, rec)
        # This pane was armed and is now sitting at a bare shell, so the last
        # command either ran and exited or was never understood. Either way,
        # spelling it out is the one form that cannot fail twice — without
        # this, an unrunnable command is retyped every scan, forever.
        plain = bool(rec.pop("armed_with_alias", False))
        try:
            command = stub_command(pane_id, plain=plain)
            rec["armed_with_alias"] = command.startswith(ARM_FUNCTION + " ")
            herdr("pane", "run", pane_id, command)
        except RuntimeError as exc:  # pane vanished mid-sweep; try again later
            log("SKIP restore %s (%s): %s" % (label, pane_id, exc))
            continue
        tab_id = pane.get("tab_id", rec.get("tab_id", ""))
        cur_label = tab_labels.get(tab_id, "")
        if tab_id and label and not cur_label.startswith("💤"):
            try:
                herdr("tab", "rename", tab_id, "💤 %s" % label)
            except RuntimeError:
                pass
        restored += 1
        log("RESTORED %s (%s): re-armed stub for session %s" % (
            label, pane_id, rec["uuid"]))
    if not dry_run:
        gc_stub_files(state)
    return restored


