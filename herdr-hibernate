# ---------------------------------------------------------------- utilities

_log_max_bytes = 512 * 1024  # updated from LOG_MAX_KB by load_config()
# Updated from EXCERPT_LINES by load_config(). Two values, because "print the
# whole reply" and "print no reply at all" are both things you can ask for:
