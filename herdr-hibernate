        "replay_flags": ("-c", "-m", "--model", "-p", "--profile",
                         "-s", "--sandbox", "-a", "--ask-for-approval",
                         "-C", "--cd", "--add-dir"),
        "replay_bool_flags": (
            "--oss", "--yolo",
            "--dangerously-bypass-approvals-and-sandbox",
