    "claude": {
        "transcript_glob": os.path.expanduser("~/.claude/projects/*/{sid}.jsonl"),
        # An orchestrator with background sub-agents (Agent tool / workflows)
        # sits at its prompt while the workers append here — the main jsonl
        # goes stale even though the session is mid-flight. Counting these
        # keeps a watching orchestrator from ever classifying as idle.
        "activity_globs": (
            os.path.expanduser("~/.claude/projects/*/{sid}/subagents/*.jsonl"),),
        "bin": "claude",
        "resume_argv": ["claude", "--resume", "{sid}"],
        "session_in_args": r"--resume\s+(%s)" % UUID_RE,
        "helper_tokens": ("bg-pty-host", "bg-spare", " daemon "),
        "replay_flags": (),
    },
    "codex": {
        # rollout-<local-timestamp>-<uuid>.jsonl, nested by year/month/day.
        # `codex resume` appends to this same file and keeps the same id, so
        # the mapping is stable across any number of hibernate/resume cycles.
        "transcript_glob": os.path.expanduser(
            "~/.codex/sessions/*/*/*/rollout-*-{sid}.jsonl"),
        "bin": "codex",
        "resume_argv": ["codex", "resume", "{sid}"],
        "session_in_args": r"resume\s+(%s)" % UUID_RE,
        "helper_tokens": (),
        # Flags that must survive a resume: config overrides, model/profile
        # choices, and — important for safety — sandbox/approval settings and
        # working roots, so a resumed session is never LESS restricted than
        # the one that was killed. Anything unlisted is dropped (a stray
